# Copy this file to .env and fill in your keys. Never commit .env.

# --- Gemini (the "AI helper") ---
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Main model. Tip: when gemini-3.8-flash is overloaded, set this to gemini-3.5-flash-lite for speed.
GEMINI_MODEL=gemini-3.8-flash
# Backup model when the main one is busy, rate-limited or too slow. Leave empty to disable.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Seconds to wait for one model before trying the backup
GEMINI_TIMEOUT_S=12

# --- Fact checks ---
# Free key from Google Cloud console: enable "Fact Check Tools API", then create an API key
FACTCHECK_API_KEY=

# --- Local models ---
# Hugging Face face-deepfake classifier (downloaded once on first start)
DEEPFAKE_MODEL=prithivMLmods/Deep-Fake-Detector-v2-Model
# Hugging Face AI-vs-human image classifier
AI_IMAGE_MODEL=Ateeqq/ai-vs-human-image-detector
# Set to 0 to skip loading the local models (faster start, fewer signals)
LOAD_LOCAL_MODELS=1

# --- Storage ---
# SQLite file for the shared verdict cache and community reports
DB_PATH=scrollsafe.db

# --- Scoring thresholds (0-1). Raise them if too many normal videos get a warning. ---
# Combined deepfake score for red (Gemini must also see signs of editing)
RED_AT=0.75
# Combined deepfake score for yellow
DEEPFAKE_YELLOW_AT=0.6
# Combined AI-generated score for yellow
AI_YELLOW_AT=0.6
# AI-generated score for red when the video also makes risky claims or shows scam signs
AI_WITH_RISK_RED_AT=0.6
# Yellow threshold used instead of the two above when Gemini is unavailable or turned off
LOCAL_ONLY_YELLOW_AT=0.9
